# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Reown AppKit (WalletConnect) — get a project ID at https://cloud.reown.com
NEXT_PUBLIC_REOWN_PROJECT_ID=your_reown_project_id

# VTpass
VTPASS_BASE_URL=https://sandbox.vtpass.com/api
VTPASS_API_KEY=your_vtpass_api_key
VTPASS_PUBLIC_KEY=your_vtpass_public_key
VTPASS_SECRET_KEY=your_vtpass_secret_key

# Upstash Redis
UPSTASH_REDIS_URL=rediss://default:your_token@your-db.upstash.io:6380

# Resend
RESEND_API_KEY=re_your_resend_api_key

# Sentry
SENTRY_DSN=https://your_key@sentry.io/your_project_id
NEXT_PUBLIC_SENTRY_DSN=https://your_key@sentry.io/your_project_id

# Webhook
WEBHOOK_SECRET=your_random_webhook_secret_here

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
