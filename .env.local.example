# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Privy — get your production app ID at https://dashboard.privy.io (must be 25 chars, e.g. clxxxxxxxxxxxxxxxxxxxxxxx)
NEXT_PUBLIC_PRIVY_APP_ID=cl00000000000000000000000

# Flutterwave Bills API (Get test keys at https://dashboard.flutterwave.com)
FLW_SECRET_KEY=FLWSECK_TEST-your_secret_key_here
FLW_PUBLIC_KEY=FLWPUBK_TEST-your_public_key_here

# Upstash Redis
UPSTASH_REDIS_URL=rediss://default:your_token@your-db.upstash.io:6380

# Resend
RESEND_API_KEY=re_your_resend_api_key

# Sentry
SENTRY_DSN=https://your_key@sentry.io/your_project_id
NEXT_PUBLIC_SENTRY_DSN=https://your_key@sentry.io/your_project_id

# Webhook
WEBHOOK_SECRET=your_random_webhook_secret_here

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
